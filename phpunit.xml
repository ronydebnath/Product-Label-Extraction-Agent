<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!-- These are <server> and not <env>, and force="true" is load-bearing. compose hands the
             whole of .env to the container as real environment variables (env_file), PHP's default
             variables_order puts those in $_SERVER, and Laravel's env() reads $_SERVER before $_ENV.
             A <env> entry only reaches getenv() and $_ENV, so the container's values would keep
             winning and the suite would silently run as APP_ENV=local against the development
             database and the real Redis queue. force="true" is needed on top because PHPUnit leaves
             an already-set variable alone. Verified: the values below are what the app actually sees. -->
        <server name="APP_ENV" value="testing" force="true"/>
        <server name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <server name="BCRYPT_ROUNDS" value="4" force="true"/>
        <server name="BROADCAST_CONNECTION" value="null" force="true"/>
        <server name="CACHE_STORE" value="array" force="true"/>
        <server name="MAIL_MAILER" value="array" force="true"/>
        <server name="SESSION_DRIVER" value="array" force="true"/>
        <!-- Real Postgres, separate database (created by docker/postgres/init-test-db.sh).
             Host and credentials come from the container environment. -->
        <server name="DB_CONNECTION" value="pgsql" force="true"/>
        <server name="DB_DATABASE" value="app_test" force="true"/>
        <server name="DB_URL" value="" force="true"/>
        <!-- Real Redis, isolated from dev data by database index. -->
        <server name="REDIS_DB" value="9" force="true"/>
        <server name="REDIS_CACHE_DB" value="10" force="true"/>
        <!-- sync by default so a forgotten Queue::fake() runs inline and is visible in assertions;
             the one end-to-end queue test switches to the redis connection explicitly. -->
        <server name="QUEUE_CONNECTION" value="sync" force="true"/>
        <server name="UPLOADS_DISK" value="local" force="true"/>
        <server name="PULSE_ENABLED" value="false" force="true"/>
        <server name="TELESCOPE_ENABLED" value="false" force="true"/>
        <server name="NIGHTWATCH_ENABLED" value="false" force="true"/>
    </php>
</phpunit>
