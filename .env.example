# Copy to .env, then generate the key:
#   docker compose run --rm --no-deps web php artisan key:generate
APP_NAME="Label Extraction"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Containers log to stderr and the platform collects it. For structured logs in production:
# LOG_STDERR_FORMATTER=Monolog\Formatter\JsonFormatter
LOG_CHANNEL=stderr
LOG_LEVEL=debug
LOG_DEPRECATIONS_CHANNEL=null

# Hosts are compose service names. compose.yaml also reads DB_* to configure the postgres container.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=app
DB_USERNAME=app
DB_PASSWORD=secret

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
# Must exceed the job timeout (90s) or Horizon re-delivers a job that is still running. See DECISIONS.md.
REDIS_QUEUE_RETRY_AFTER=150

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=redis
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Where uploads live. `local` = storage/app/private on the `uploads` volume (single host only).
# `s3` = any S3-compatible bucket via the AWS_* values below; the production choice, see DECISIONS.md.
UPLOADS_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
