# Build context hygiene: nothing secret, nothing host-specific, nothing the stages rebuild themselves.
.git
.gitattributes
.github
.env
.env.*
!.env.example
.DS_Store
.idea
.vscode
node_modules
vendor
public/build
public/hot
public/vendor
bootstrap/cache/*.php
storage/app/private/*
storage/app/public/*
storage/framework/cache/data
storage/framework/sessions/*
storage/framework/testing/*
storage/framework/views/*
storage/logs/*
!**/.gitignore
compose*.yaml
Dockerfile
.dockerignore
*.md
docs
